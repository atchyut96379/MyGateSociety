# Python + SQL Server (Developer Edition) — local development
# Copy to .env and adjust if needed.

# Docker SQL Server (default — requires Docker Desktop running):
DATABASE_URL=mssql+pymssql://sa:MyGate_Dev12345@localhost:1433/mygatesociety

# Windows SQL Server named instance (no Docker) — example for ATCHYUT3446:
# DATABASE_URL=mssql+pymssql://sa:YOUR_SQL_PASSWORD@localhost/ATCHYUT3446/mygatesociety
JWT_SECRET=change-this-in-production-use-32-bytes
ENVIRONMENT=development
SQLSERVER_EDITION=Developer
API_HOST=0.0.0.0
API_PORT=8000

# Razorpay (test or live keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Production (Azure App Service): comma-separated frontend origins
# CORS_ORIGINS=https://www.marvelrocks.in,https://marvelrocks.in
